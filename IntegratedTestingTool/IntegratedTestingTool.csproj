<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>IntegratedTestingTool.ico</ApplicationIcon>
    <!-- 版本由 AssemblyInfo.cs 统一定义，避免 SDK 重复生成属性。 -->
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="IntegratedTestingTool.ico" />
    <Resource Include="..\device-emulator\DeviceEmulator.ico" Link="Icons\DeviceEmulator.ico" />
    <Resource Include="..\httpserver\HTTPServer.ico" Link="Icons\HTTPServer.ico" />
    <Resource Include="..\log-profiler\logprofiler.ico" Link="Icons\LogProfiler.ico" />
    <Resource Include="..\net-tool\NetTool.ico" Link="Icons\NetTool.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ManualUpdateController.cs" Link="Updates\ManualUpdateController.cs" />
    <ProjectReference Include="..\general-library\GeneralLibrary\GeneralLibrary.csproj" />
  </ItemGroup>
</Project>
