<Window x:Class="IntegratedTestingTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="集成测试工具" Height="555" Width="870" MinHeight="440" MinWidth="720"
        Icon="IntegratedTestingTool.ico" WindowStartupLocation="CenterScreen">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="检查更新"
                    Style="{DynamicResource ThemeSecondaryButtonStyle}" Click="Refresh_Click" />
            <TextBlock Text="工具启动器" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ToolList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource Theme.BorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" Margin="0,0,12,0" CornerRadius="6"
                                        Background="{DynamicResource Theme.SecondaryBackgroundBrush}"
                                        VerticalAlignment="Center">
                                    <Image Source="{Binding IconUri}" Width="32" Height="32" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="本机版本 " />
                                        <TextBlock Text="{Binding LocalVersionText}" Margin="0,0,16,0" />
                                        <TextBlock Text="服务器版本 " />
                                        <TextBlock Text="{Binding ServerVersionText}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Status}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="选择程序" Margin="0,0,8,0" IsEnabled="{Binding CanSelect}"
                                            ToolTip="{Binding ExecutablePath, TargetNullValue=选择工具的 EXE 文件}"
                                            Style="{DynamicResource ThemeSecondaryButtonStyle}" Click="SelectProgram_Click" />
                                    <Button Content="{Binding InstallLabel}" Margin="0,0,8,0" MinWidth="70"
                                            IsEnabled="{Binding CanInstall}"
                                            Style="{DynamicResource ThemeSecondaryButtonStyle}" Click="Install_Click" />
                                    <Button Content="启动" MinWidth="64" IsEnabled="{Binding CanLaunch}"
                                            Style="{DynamicResource ThemeButtonStyle}" Click="Launch_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
