{
  "PackageTransfer": {
    "SourceDirectory": "D:\\Ftp\\Uploads",
    "DestinationDirectory": "D:\\Website\\Packages",
    "ScanIntervalSeconds": 30,
    "OldVersionsToKeep": 1,
    "SearchPattern": "*.exe"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "SourceName": "PackageTransferService",
      "LogName": "Application",
      "LogLevel": {
        "Microsoft": "Information"
      }
    }
  }
}
