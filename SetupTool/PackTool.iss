; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName ""
#define MyAppId ""
#define MyAppVersion ""
#define MyOutputDir ""
#define MyAppPublisher "DickRed"
#define DotNetFrameworkLoadUrl "https://go.microsoft.com/fwlink/?linkid=2088631"
#define MySQLDownLoadUrl "https://dev.mysql.com/get/Downloads/MySQLInstaller/mysql-installer-community-5.7.44.0.msi"
#define MyAppURL "https://www.example.com/"
#define MyUpdateMessage ""
#define MyAppExeName MyAppName + ".exe"
#define MyAppAssocName MyAppName + " File"
#define MyAppAssocExt ".myp"
#define MyAppAssocKey StringChange(MyAppAssocName, " ", "") + MyAppAssocExt

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{#MyAppId}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
VersionInfoVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={#MyAppName}
ChangesAssociations=yes
DisableProgramGroupPage=yes
DisableDirPage=no
CreateUninstallRegKey=yes
; Uncomment the following line to run in non administrative install mode (install for current user only.)
;PrivilegesRequired=lowest
OutputDir={#MyOutputDir}\bin
OutputBaseFilename={#MyAppName}-{#MyAppVersion}-{#MyUpdateMessage}
SetupIconFile=icon.ico
Compression=lzma
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired = admin
ArchitecturesInstallIn64BitMode=x64


[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "chinese"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[UninstallDelete]
Type: dirifempty; Name:"{app}"

[Files]
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Registry]
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocExt}\OpenWithProgids"; ValueType: string; ValueName: "{#MyAppAssocKey}"; ValueData: ""; Flags: uninsdeletevalue
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}"; ValueType: string; ValueName: ""; ValueData: "{#MyAppAssocName}"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""
Root: HKA; Subkey: "Software\Classes\Applications\{#MyAppExeName}\SupportedTypes"; ValueType: string; ValueName: ".myp"; ValueData: ""

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]
var IsFirstinstall: Boolean;

function IsAdmin: Boolean;
begin
  Result := IsAdminLoggedOn;
  if not Result then
  begin
    MsgBox('此安装程序需要管理员权限。请以管理员身份重新运行。', mbError, MB_OK);
  end;
end;

//此函数用于截取版本号数字
procedure DecodeVersion (verstr: String; var verint: array of Integer);
var
  i,p: Integer; s: string;
begin
  verint := [0,0,0,0];
  i := 0;
  while ((Length(verstr) > 0) and (i < 4)) do
  begin
    p := pos ('.', verstr);
    if p > 0 then
    begin
      if p = 1 then s:= '0' else s:= Copy (verstr, 1, p - 1);
      verint[i] := StrToInt(s);
      i := i + 1;
      verstr := Copy (verstr, p+1, Length(verstr));
    end
    else
    begin
      verint[i] := StrToInt (verstr);
      verstr := '';
    end;
  end;
end;


// 此函数用于比较版本字符串
// 若 ver1 > ver2 返回值  1
// 若 ver1 = ver2 返回值  0
// 若 ver1 < ver2 返回值 -1
function CompareVersion (ver1, ver2: String) : Integer;
var
  verint1, verint2: array of Integer;
  i: integer;
begin
  SetArrayLength (verint1, 4);
  DecodeVersion (ver1, verint1);
  SetArrayLength (verint2, 4);
  DecodeVersion (ver2, verint2);
  Result := 0; i := 0;
  while ((Result = 0) and (i < 4)) do
  begin
    if verint1[i] > verint2[i] then
    begin
      Result := 1
      Exit;
    end
    else
    begin
      if verint1[i] < verint2[i] then
      begin
        Result := -1
        Exit;
      end
      else
        Result := 0;
    end;
    i := i + 1;
  end;
end;

function CheckDotNetVersion: Boolean;
var
  DotNetVersion: String;
  InstallerPath: String;
  ResultCode: Integer;
begin
  Result := true;
  InstallerPath := ExpandConstant('C:\NDP48-DevPack-ENU.exe');
  // 查询 .NET Framework 4.x 的 Release 值
  RegQueryStringValue(HKLM, 'SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full', 'Version', DotNetVersion)
  DotNetVersion := Copy(DotNetVersion, 1, 3)
  if not (CompareVersion(DotNetVersion, '4.8') = 0) then
  begin
    MsgBox('当前安装的Framework不是4.8，点击确定后下载并安装4.8', mbInformation, MB_OK);
    Result := false;
    if Exec('curl.exe', ' -L -o "' +InstallerPath+'" {#DotNetFrameworkLoadUrl}','', SW_SHOW, ewWaitUntilTerminated, ResultCode) then
    begin
      if Exec(InstallerPath, '/passive /norestart', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
      begin
        MsgBox('安装成功!', mbInformation, MB_OK);
        DeleteFile(InstallerPath);
      end;
    end;
  end;
end;

function GetMySQLVersion(rootDirectory: String): String;
var
  ResultCode: Integer;
  OutputFile: String;
  Version: String;
  OutputContent: TStringList;
begin
  Result := '';
  OutputFile := ExpandConstant('C:\mysql_version.txt');
  
  // 假设 MySQL 安装路径
  if Exec('cmd.exe', '/C ""' + rootDirectory + '" --version > ' + OutputFile + '"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
  begin
    if FileExists(OutputFile) then
    begin
      OutputContent := TStringList.Create;
      try
        OutputContent.LoadFromFile(OutputFile);
        if OutputContent.Count > 0 then
        begin
          // 提取版本号
          Version:= Trim(OutputContent[0]);
          Delete(Version, Pos(', for Win64 (x86_64)', Version), Length(', for Win64 (x86_64)'));
          Delete(Version, 1, Pos('b ', Version) + 1);
          Result:=Version;
        end;
      finally
        OutputContent.Free;
      end;
    end
    else
    begin
      MsgBox('提取MySQL版本失败，没有找到导入文件。', mbError, MB_OK);
    end;
  end
  else
  begin
    MsgBox('执行MySQL指令失败。', mbError, MB_OK);
  end;
  
  // 清理临时文件
  if FileExists(OutputFile) then
    DeleteFile(OutputFile);
end;

function IsMySQLInstalledByPath: Boolean;
var
  InstallPath: TStringList;
  i: Integer;
  IsVisiable: integer;
  VersionCount: Integer;
  VersionList: TStringList;
begin
  // 假设 MySQL 通常安装在以下路径(5和8的默认安装路径不一样)
  InstallPath := TStringList.Create;
  InstallPath.Add('C:\Program Files\MySQL\MySQL Server 5.7\bin\mysql.exe');
  InstallPath.Add('C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe');
  VersionList := TStringList.Create;
  i := 0;
  VersionList.Add(GetMySQLVersion('C:\Program Files\MySQL\MySQL Server 5.7\bin\mysql.exe'));
  VersionList.Add(GetMySQLVersion('C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe'));
  VersionCount := VersionList.Count;
  IsVisiable := CompareVersion(VersionList[i], '8.2.0');
  while(i < VersionCount) do
  begin
    if (CompareVersion(VersionList[i], '8.2.0') < 0) and FileExists(InstallPath[i]) then
    begin
      Result := true;
      Break;
    end
    else
    begin
      Result:=false;
    end;
    i := i + 1;
  end;
end;

function InstallMySQL: Boolean;
var
  ResultCode: Integer;
  InstallerPath: String;
begin
  // 定义 MSI 安装程序的路径
  InstallerPath := ExpandConstant('C:\mysql-installer-community-5.7.44.0.msi');
  
  if not IsMySQLInstalledByPath() then
  begin
    // 确保 MSI 文件已复制到临时目录
    if not FileExists(InstallerPath) then
    begin
      MsgBox('MySQL 安装软件未找到，即将开始自动下载。。。 ', mbError, MB_OK)
      if not Exec('curl.exe', ' -L -o "' +InstallerPath+'" {#MySQLDownLoadUrl}','', SW_SHOW, ewWaitUntilTerminated, ResultCode) then
        Result := False;
    end;
    // 执行 MSI 安装程序
    if Exec('msiexec.exe', '/i "' + InstallerPath + '" /quiet /norestart', '', SW_SHOW, ewWaitUntilTerminated, ResultCode) then
    begin
      if ResultCode = 0 then
      begin
        DeleteFile(InstallerPath);
        Result := True;
      end
      else
      begin
        MsgBox('MySQL 数据库安装失败。异常码：' + IntToStr(ResultCode), mbError, MB_OK);
        Result := False;
      end;
    end
    else
    begin
      MsgBox('MySQL 安装路径查找失败!', mbError, MB_OK);
      Result := False;
    end;
  end;
end;


function IsAppInstalled(): Boolean;
var
  InstallPath: String;
begin
  // 尝试读取注册表中的安装路径
  Result := RegQueryStringValue(
    HKEY_LOCAL_MACHINE, // 注册表根键
    'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppId}_is1', // AppId 对应路径
    'InstallLocation', // 要读取的值名称，iss默认键
    InstallPath // 返回的安装路径
  );

  if Result and (InstallPath <> '') then
  begin
    IsFirstinstall := true
    MsgBox('检测到现有安装，此次为升级安装。', mbInformation, MB_OK);
  end
  else
  begin
    IsFirstinstall := false
    MsgBox('此次为全新安装。', mbInformation, MB_OK);
  end;
end;

procedure SetMySQLPassword();
var
  ResultCode: Integer;

begin
  MsgBox('MySQL 数据库安装需要一段时间，请耐心等待。', mbInformation, MB_OK);
  // 初始化 MySQL 数据目录
  if Exec(
    ExpandConstant('C:\Program Files (x86)\MySQL\MySQL Installer for Windows\MySQLInstallerConsole.exe'),
    'community Install -silent server;5.7.44;x64:*:type=config;openfirewall=false;generallog=true;binlog=true;serverid=3306;enable_tcpip=true;port=3306;servicename=MySQL5.7;rootpasswd=admin;installdir="C:\Program Files\MySQL\MySQL Server 5.7";datadir="C:\Program Files\MySQL\MySQL Server 5.7\data"',
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode
  ) then
  begin
    MsgBox('MySQL 数据库安装成功！', mbInformation, MB_OK);
  end
  else
    MsgBox('MySQL 安装失败！错误代码：' + IntToStr(ResultCode), mbError, MB_OK);
end;

procedure InitializeWizard();
begin
  if not IsAdmin then
  begin
    WizardForm.Close
  end;
  if InstallMySQL() then
  begin
    SetMySQLPassword()
  end;
  IsAppInstalled()
  CheckDotNetVersion()
end;