<Window x:Class="DeviceEmulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:DeviceEmulator" 
        xmlns:viewmodel="clr-namespace:DeviceEmulator.ViewModel" 
        d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/DeviceEmulator;component/DeviceEmulator.ico"
        Title="下位机模拟助手" Height="600" Width="980">
    <Window.Resources>
        <!--快捷命令区内容样式-->
        <Style TargetType="ItemsControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Button Content="{Binding Content}" CommandParameter="{Binding}" Command="{Binding CommandExd}" Margin="4"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--顺序发送命令列表样式，可拖动控件-->
        <Style TargetType="ListBox" BasedOn="{StaticResource ListBoxBaseStyle}">
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Content}"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4">
                                <TextBlock Text="与下一条命令的间隔时间：" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding IntervalTime}" Width="100"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemBaseStyle}">
                        <Setter Property="AllowDrop" Value="True"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_MouseDown"/>
                        <EventSetter Event="MouseMove" Handler="Item_MouseMove"/>
                        <EventSetter Event="Drop" Handler="Item_Drop"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="GroupBox" BasedOn="{StaticResource BaseStyle}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource Theme.SecondaryBackgroundBrush}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="4" Background="Transparent">
            <TextBlock Text="设备地址:" VerticalAlignment="Center" Margin="4" Foreground="{DynamicResource Theme.WindowForegroundBrush}"/>
            <hc:ComboBox Width="130" Height="20" Margin="4,2" ItemsSource="{Binding IPList}" SelectedItem="{Binding LocalIP}"/>
            <TextBlock Text="设备端口:" VerticalAlignment="Center" Margin="4" Foreground="{DynamicResource Theme.WindowForegroundBrush}"/>
            <TextBox Width="100" Height="20" Margin="4,2" Text="{Binding LocalPort}"/>
            <TextBlock Text="上位机地址:" VerticalAlignment="Center" Margin="4" Foreground="{DynamicResource Theme.WindowForegroundBrush}"/>
            <hc:ComboBox Width="130" Height="20" Margin="4,2" ItemsSource="{Binding IPList}" SelectedItem="{Binding IpcIP}"/>
            <TextBlock Text="上位机端口:" VerticalAlignment="Center" Margin="4" Foreground="{DynamicResource Theme.WindowForegroundBrush}"/>
            <TextBox Width="100" Height="20" Margin="4,2" Text="{Binding IpcPort}"/>
            <Button Content="连接" Command="{Binding ConnectComExd}" Margin="4"/>
            <Button Content="断开" Command="{Binding DisconnectComExd}" Margin="4"/>
            <Button Content="默认设备IP" Command="{Binding OpenIPConfigPage}" Margin="4"/>
        </StackPanel>
        <GroupBox Grid.Row="1" Grid.Column="0" Header="数据日志" Background="Transparent" Foreground="{DynamicResource Theme.WindowForegroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="9*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <RichTextBox Grid.Row="1" x:Name="richTextBox" local:RichTextBoxHelper.BoundDocument="{Binding RichTextBoxDocument}" Margin="4" Foreground="{DynamicResource Theme.WindowForegroundBrush}" TextChanged="richTextBox_TextChanged"/>
                <Button Grid.Row="0" HorizontalAlignment="Right" Content="清空报文信息" Command="{Binding ClearRichTextDocumentExd}" Margin="4"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1" Grid.Column="1" Header="快捷命令" Background="Transparent" Foreground="{DynamicResource Theme.WindowForegroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Background="Transparent">
                    <Label Content="PLC协议版本:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4" Background="Transparent" Foreground="{DynamicResource Theme.WindowForegroundBrush}"/>
                    <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" Width="60" Margin="4,2" Text="{Binding PlcType}" IsHitTestVisible="False"/>
                    <Button Content="生成快捷命令" Command="{Binding OpenSetingExd}" HorizontalAlignment="Left" Margin="4"/>
                    <Button Content="清空快捷命令" Command="{Binding ClearQuickCmdExd}" HorizontalAlignment="Left" Margin="4"/>
                    <Button Content="批量执行" Command="{Binding BatchExecutionCmdExd}" HorizontalAlignment="Left" Margin="4"/>
                </StackPanel>
                <TabControl
                    Grid.Row="1" 
                    Visibility="{Binding TableControlVisibility}" 
                    SelectedIndex="{Binding DeviceSelectedIndex}"
                    BorderThickness="0"
                    Background="Transparent"
                    Margin="4">
                    <hc:TabItem Header="自动供包PLC" Background="Transparent" Foreground="{DynamicResource Theme.WindowForegroundBrush}">
                        <hc:ScrollViewer VerticalScrollBarVisibility="Visible">
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding PSSPLCButtonList}"/>
                        </hc:ScrollViewer>
                    </hc:TabItem>
                    <hc:TabItem Header="相机" Background="Transparent" Foreground="{DynamicResource Theme.WindowForegroundBrush}">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,4">
                                <CheckBox Content="自动回复摆轮数据" Foreground="{DynamicResource Theme.WindowForegroundBrush}" Margin="4" VerticalAlignment="Center"
                                          IsChecked="{Binding IsBalanceWheelAutoReplyEnabled}"
                                          ToolTip="收到1B01后按所选结果回复1B06；package_id使用最新1B01的msg_id。"/>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="自动回复结果：" Foreground="{DynamicResource Theme.WindowForegroundBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Width="180" ItemsSource="{Binding BalanceWheelAutoReplyResults}"
                                              DisplayMemberPath="Value" SelectedValuePath="Key"
                                              SelectedValue="{Binding BalanceWheelAutoReplyResultType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </WrapPanel>
                            <hc:ScrollViewer VerticalScrollBarVisibility="Visible">
                                <ItemsControl ItemsSource="{Binding CameraButtonList}"/>
                            </hc:ScrollViewer>
                        </DockPanel>
                    </hc:TabItem>
                    <hc:TabItem Header="摆轮" Background="Transparent" Foreground="{DynamicResource Theme.WindowForegroundBrush}">
                        <hc:ScrollViewer VerticalScrollBarVisibility="Visible">
                            <ItemsControl ItemsSource="{Binding BalanceWheelButtonList}"/>
                        </hc:ScrollViewer>
                    </hc:TabItem>
                    <hc:TabItem Header="格口控制器" Background="Transparent" Foreground="{DynamicResource Theme.WindowForegroundBrush}">
                        <hc:ScrollViewer VerticalScrollBarVisibility="Visible">
                            <ItemsControl ItemsSource="{Binding SortPortBoardButtonList}"/>
                        </hc:ScrollViewer>
                    </hc:TabItem>
                </TabControl>
                <Grid Grid.Row="1" Visibility="{Binding BatchExecutionVisibility}" Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox ItemsSource="{Binding ButtonList}" SelectedItem="{Binding SelectedButton}" Background="Transparent">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="删除" Command="{Binding DeleteBatchExecutionButtonCmd}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <CheckBox Content="循环发送" Foreground="{DynamicResource Theme.WindowForegroundBrush}" IsChecked="{Binding IsLoopSend}" Margin="4"/>
                        <TextBox Text="{Binding LoopSpan}" IsEnabled="{Binding IsLoopSend}" Width="60" Height="20" Margin="4,0"/>
                        <Label Content="循环间隔(ms)" VerticalAlignment="Center" Margin="4" Background="Transparent" Foreground="{DynamicResource Theme.WindowForegroundBrush}"/>
                        <Button Command="{Binding ExecutionCmd}" Content="执行" Margin="4"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="输入区" Background="Transparent" Foreground="{DynamicResource Theme.WindowForegroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding AddCommondMessage}" Margin="4"/>
                <Button Grid.Column="1" Content="发送" Command="{Binding SendCommondComExd}" Margin="4"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
