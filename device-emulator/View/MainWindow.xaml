<Window x:Class="DeviceEmulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:DeviceEmulator" 
        xmlns:viewmodel="clr-namespace:DeviceEmulator.ViewModel" 
        d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="下位机模拟助手" Height="520" Width="980">
    <Window.Resources>
        <!--快捷命令区内容样式-->
        <Style TargetType="ItemsControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Button Content="{Binding Content}" Style="{DynamicResource ButtonInfo}" CommandParameter="{Binding}" Command="{Binding CommandExd}" Margin="4"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GroupBox" BasedOn="{StaticResource BaseStyle}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="AliceBlue"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="4" Background="AliceBlue">
            <TextBlock Text="设备地址:" VerticalAlignment="Center" Margin="4"/>
            <hc:ComboBox Width="130" Height="20" Margin="4,2" ItemsSource="{Binding IPList}" SelectedItem="{Binding LocalIP}"/>
            <TextBlock Text="设备端口:" VerticalAlignment="Center" Margin="4"/>
            <TextBox Width="100" Height="20" Margin="4,2" Text="{Binding LocalPort}"/>
            <TextBlock Text="上位机地址:" VerticalAlignment="Center" Margin="4"/>
            <hc:ComboBox Width="130" Height="20" Margin="4,2" ItemsSource="{Binding IPList}" SelectedItem="{Binding IpcIP}"/>
            <TextBlock Text="上位机端口:" VerticalAlignment="Center" Margin="4"/>
            <TextBox Width="100" Height="20" Margin="4,2" Text="{Binding IpcPort}"/>
            <Button Content="连接" Command="{Binding ConnectComExd}" Style="{StaticResource ButtonSuccess}" Margin="4"/>
            <Button Content="断开" Command="{Binding DisconnectComExd}" Style="{StaticResource ButtonDanger}" Margin="4"/>
            <Button Content="默认设备IP" Command="{Binding OpenIPConfigPage}" Style="{StaticResource ButtonWarning}" Margin="4"/>
        </StackPanel>
        <GroupBox Grid.Row="1" Grid.Column="0" Header="数据日志">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <RichTextBox x:Name="richTextBox" local:RichTextBoxHelper.BoundDocument="{Binding RichTextBoxDocument}" Margin="4" Foreground="#10AAED" TextChanged="richTextBox_TextChanged"/>
                <Button Grid.Row="1" HorizontalAlignment="Right" Content="清空报文信息" Style="{StaticResource ButtonDanger}" Command="{Binding ClearRichTextDocumentExd}" Margin="4"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1" Grid.Column="1" Header="快捷命令">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Background="AliceBlue">
                    <TextBlock Text="PLC协议版本:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4"/>
                    <ComboBox Width="60" Height="20" Margin="4,2" ItemsSource="{Binding PLCTypes}" SelectedItem="{Binding PlcType}"/>
                    <Button Content="设置快捷命令" Style="{StaticResource ButtonPrimary}" Command="{Binding OpenSetingExd}" HorizontalAlignment="Left" Margin="4"/>
                    <Button Content="清空快捷命令" Style="{StaticResource ButtonDanger}" Command="{Binding ClearQuickCmdExd}" HorizontalAlignment="Left" Margin="4"/>
                </StackPanel>
                <TabControl Grid.Row="1" Style="{StaticResource TabControlCapsuleSolid}" SelectedIndex="{Binding DeviceSelectedIndex}" Margin="4">
                    <hc:TabItem Header="单件分离PLC">
                        <hc:ScrollViewer VerticalScrollBarVisibility="Visible">
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding PSSPLCButtonList}"/>
                        </hc:ScrollViewer>
                    </hc:TabItem>
                    <hc:TabItem Header="相机">
                        <hc:ScrollViewer VerticalScrollBarVisibility="Visible">
                            <ItemsControl ItemsSource="{Binding CameraButtonList}"/>
                        </hc:ScrollViewer>
                    </hc:TabItem>
                    <hc:TabItem Header="摆轮">
                        <hc:ScrollViewer VerticalScrollBarVisibility="Visible">
                            <ItemsControl ItemsSource="{Binding BalanceWheelButtonList}"/>
                        </hc:ScrollViewer>
                    </hc:TabItem>
                    <hc:TabItem Header="格口控制器">
                        <hc:ScrollViewer VerticalScrollBarVisibility="Visible">
                            <ItemsControl ItemsSource="{Binding SortPortBoardButtonList}"/>
                        </hc:ScrollViewer>
                    </hc:TabItem>
                </TabControl>
                <CheckBox Grid.Row="2" Content="循环发送" IsChecked="{Binding IsLoopSend}" Margin="4"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="输入区">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding AddCommondMessage}" Margin="4"/>
                <Button Grid.Column="1" Content="发送" Command="{Binding SendCommondComExd}" Style="{StaticResource ButtonPrimary}" Margin="4"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
