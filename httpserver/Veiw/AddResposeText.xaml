<hc:PopupWindow x:Class="HTTPServer.Veiw.AddResposeText"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HTTPServer.Veiw" 
        xmlns:veiwmodel="clr-namespace:HTTPServer.VeiwModel" 
        d:DataContext="{d:DesignInstance Type=veiwmodel:MainViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="添加响应文本" Height="100" Width="300">
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="文件名：" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"/>
        <TextBox Text="{Binding FileName}" MinWidth="140" Height="20" HorizontalAlignment="Center" Margin="8"/>
        <Button Content="确定" Command="{Binding CreateNewPlanCmd}" Margin="8"/>
    </StackPanel>
</hc:PopupWindow>
