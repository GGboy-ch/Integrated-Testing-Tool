<hc:Window x:Class="HTTPServer.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:veiwmodel="clr-namespace:HTTPServer.VeiwModel"
           d:DataContext="{d:DesignInstance Type=veiwmodel:MainViewModel}"
           mc:Ignorable="d"
           WindowStartupLocation="CenterScreen"
           Icon="pack://application:,,,/HTTPServer;component/Images/HTTPServer.ico"
           Title="HTTP服务器"
           Width="1080"
           Height="680"
           MinWidth="900"
           MinHeight="560"
           Background="{DynamicResource Theme.WindowBackgroundBrush}">
    <Window.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.WindowBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Theme.SecondaryBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Theme.SecondaryBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox" BasedOn="{StaticResource ListBoxBaseStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemBaseStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="IsSelected" Value="True"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Theme.SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="HTTP Server"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="本地请求模拟与响应调试"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="客户" Style="{StaticResource CaptionStyle}" Margin="0,0,8,0"/>
                    <ComboBox Width="150"
                              Height="32"
                              ItemsSource="{Binding CustomerList}"
                              SelectedItem="{Binding SelectedCustomer}"
                              Margin="0,0,8,0"/>
                    <TextBlock Text="状态码" Style="{StaticResource CaptionStyle}" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding StatusCodeList}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding SelectedStatusCode}"
                              Width="170"
                              Height="32"/>
                    <Border Background="{DynamicResource Theme.SecondaryBackgroundBrush}" CornerRadius="7" Padding="10,5" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="checkBox"
                                      IsChecked="{Binding IsTimeout}"
                                      Content="模拟延迟"
                                      VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}"
                                     Width="72"
                                     Height="28"
                                     Margin="8,0,8,0"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     IsEnabled="{Binding Path=IsChecked, ElementName=checkBox}"/>
                            <TextBlock Text="ms" Style="{StaticResource CaptionStyle}"/>
                        </StackPanel>
                    </Border>
                    <Button Width="34"
                            Height="34"
                            Margin="8,0,0,0"
                            Padding="4"
                            ToolTip="设置"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Command="{Binding NotifyCommand}"
                            CommandParameter="1">
                        <Image Source="{StaticResource SettingIcon}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="工作区"
                               Margin="8,8,8,8"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <StackPanel Grid.Row="1">
                        <Button Content="请求记录"
                                Command="{Binding ShowRecievedListCmd}"
                                Style="{StaticResource NavigationButtonStyle}"/>
                        <Button Content="监听地址"
                                Command="{Binding ShowAddressListCmd}"
                                Style="{StaticResource NavigationButtonStyle}"/>
                        <Button Content="返回内容"
                                Command="{Binding ShowSettingCmd}"
                                Style="{StaticResource NavigationButtonStyle}"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="{DynamicResource Theme.SecondaryBackgroundBrush}" CornerRadius="7" Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="当前请求数" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Text="{Binding RequestDatasCount}"
                                       Margin="0,8,0,0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Border Style="{StaticResource CardStyle}" Visibility="{Binding RecieveVisibility}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="请求记录" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="查看服务器收到的请求和返回内容"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource Theme.SecondaryBackgroundBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold">
                                    <Run Text="{Binding RequestDatasCount}"/>
                                    <Run Text=" 条记录"/>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <ListBox Grid.Row="2" ItemsSource="{Binding DisplayDatas}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Theme.SecondaryBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TriggerTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}"
                                                           Style="{StaticResource CaptionStyle}"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="查看详情"
                                                    Margin="8,0,0,0"
                                                    Padding="14,5"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.DisplayMessageCmd, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBox}}}"
                                                    CommandParameter="{Binding TriggerTime}"/>
                                            <Popup IsOpen="{Binding IsOpen}"
                                                   StaysOpen="False"
                                                   Placement="MousePoint"
                                                   AllowsTransparency="True">
                                                <Border Width="720"
                                                        MaxHeight="460"
                                                        Background="{DynamicResource Theme.SecondaryBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="18">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="12"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="请求参数" Style="{StaticResource SectionTitleStyle}" FontSize="15"/>
                                                        <TextBlock Grid.Column="2" Text="响应参数" Style="{StaticResource SectionTitleStyle}" FontSize="15"/>
                                                        <Border Grid.Row="2" Background="{DynamicResource Theme.SecondaryBackgroundBrush}" CornerRadius="7" Padding="12">
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                <TextBlock Text="{Binding RequestData}"
                                                                           FontFamily="Consolas"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource Theme.WindowForegroundBrush}"
                                                                           TextWrapping="Wrap"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                        <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource Theme.SecondaryBackgroundBrush}" CornerRadius="7" Padding="12">
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                <TextBlock Text="{Binding ResponseData}"
                                                                           FontFamily="Consolas"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource Theme.WindowForegroundBrush}"
                                                                           TextWrapping="Wrap"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Visibility="{Binding IPListVisibility}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="监听地址" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="选择本机地址并启动 HTTP 监听"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                        <ListBox Grid.Row="2" ItemsSource="{Binding IPList}" SelectedItem="{Binding SelectedURL}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Theme.SecondaryBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="32"
                                                     VerticalContentAlignment="Center"
                                                     Margin="0,0,8,0"/>
                                            <Button Grid.Column="1"
                                                    Content="开始监听"
                                                    Padding="16,5"
                                                    Command="{Binding DataContext.StartListenCmd, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBox}}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Visibility="{Binding SettingVisibility}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="返回内容" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="为指定请求路径配置模拟响应"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="2" Background="{DynamicResource Theme.SecondaryBackgroundBrush}" CornerRadius="8" Padding="12">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="格式" Style="{StaticResource CaptionStyle}" Margin="0,0,8,0"/>
                                <hc:ComboBox ItemsSource="{Binding ContentTypeList}"
                                             SelectedIndex="{Binding ContentTypeSelectedIndex}"
                                             Width="100"
                                             Height="30"
                                             Margin="0,0,8,0"/>
                                <TextBlock Text="请求路径" Style="{StaticResource CaptionStyle}" Margin="0,0,8,0"/>
                                <hc:ComboBox ItemsSource="{Binding RawUrlList}"
                                             SelectedItem="{Binding SelectedRawUrl}"
                                             Width="150"
                                             Height="30"
                                             Margin="0,0,8,0"/>
                                <TextBlock Text="响应模板" Style="{StaticResource CaptionStyle}" Margin="0,0,8,0"/>
                                <hc:ComboBox ItemsSource="{Binding ContentList}"
                                             SelectedIndex="{Binding ContentSelectedIndex}"
                                             Width="160"
                                             Height="30"
                                             Margin="0,0,8,0"/>
                                <CheckBox Content="使用指定内容"
                                          IsChecked="{Binding IsUseTextBox}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"/>
                                <Button Content="新增模板"
                                        Command="{Binding OpenAddControlCmd}"
                                        Padding="14,5"
                                        Margin="8"/>
                            </WrapPanel>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="指定响应内容" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Column="2" Text="实际响应预览" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBox x:Name="ParticularTextBox" Grid.Row="2"
                                     TextChanged="ParticularTextBox_TextChanged"
                                     IsKeyboardFocusWithinChanged="ParticularTextBox_IsKeyboardFocusWithinChanged"
                                     Text="{Binding ParticularText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsUseTextBox}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Padding="10"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="2"
                                     Text="{Binding ReposeText}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Padding="10"
                                     Background="{DynamicResource Theme.SecondaryBackgroundBrush}"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource Theme.SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="服务控制台就绪" Style="{StaticResource CaptionStyle}"/>
                    <TextBlock Text=" · 已记录 " Style="{StaticResource CaptionStyle}" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding RequestDatasCount}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text=" 个请求" Style="{StaticResource CaptionStyle}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="清空记录"
                        Padding="16,5"
                        VerticalAlignment="Center"
                        Command="{Binding ClearCmd}"/>
            </Grid>
        </Border>
    </Grid>
</hc:Window>
