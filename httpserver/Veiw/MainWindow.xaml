<hc:Window x:Class="HTTPServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HTTPServer"
        xmlns:hc="https://handyorg.github.io/handycontrol" 
        xmlns:veiwmodel="clr-namespace:HTTPServer.VeiwModel" 
        d:DataContext="{d:DesignInstance Type=veiwmodel:MainViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/HTTPServer;component/Images/HTTPServer.ico"
        Title="HTTP服务器" Height="450" Width="800">
    <Window.Resources>
        <!--设置列表样式，使选中Item中的控件之后自动选中Item-->
        <Style TargetType="ListBox" BasedOn="{StaticResource ListBoxBaseStyle}">
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemBaseStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="IsSelected" Value="True"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Border>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="客户:" VerticalAlignment="Center" Margin="4"/>
                <ComboBox MinWidth="200" MaxHeight="30" ItemsSource="{Binding CustomerList}" Margin="4" SelectedItem="{Binding SelectedCustomer}"/>
                <Button Content="URL列表" Command="{Binding ShowAddressListCmd}" Style="{StaticResource ButtonInfo}" Margin="4"/>
                <Button Content="接收内容" Command="{Binding ShowRecievedListCmd}" Style="{StaticResource ButtonWarning}" Margin="4"/>
                <Button Content="返回内容" Command="{Binding ShowSettingCmd}" Style="{StaticResource ButtonPrimary}" Margin="4"/>
                <CheckBox x:Name="checkBox" IsChecked="{Binding IsTimeout}" Content="超时时间" Margin="4"/>
                <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" Width="80" Height="30" IsEnabled="{Binding Path=IsChecked, ElementName=checkBox}" Margin="4" />
                <Button MaxHeight="60" Style="{StaticResource ButtonCustom}" Command="{Binding NotifyCommand}" CommandParameter="1" Padding="8">
                    <Image Source="{StaticResource SettingIcon}"/>
                </Button>
            </StackPanel>
        </Border>
        <hc:ScrollViewer Grid.Row="1">
            <StackPanel>
                <GroupBox Header="URL" Style="{StaticResource BaseStyle}" Margin="4" Visibility="{Binding IPListVisibility}">
                    <ListBox ItemsSource="{Binding IPList}" SelectedItem="{Binding SelectedURL}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <hc:TextBox Text="{Binding Address}" Width="160" Margin="4"/>
                                    <Button
                                        Content="监听"
                                        Command="{Binding DataContext.StartListenCmd, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBox}}}"
                                        Margin="4"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
                <GroupBox Header="接收内容" Style="{StaticResource BaseStyle}" Visibility="{Binding RecieveVisibility}" Margin="4">
                    <ListBox ItemsSource="{Binding RequestDatas}"/>
                </GroupBox>
                <GroupBox Header="返回内容" Style="{StaticResource BaseStyle}" Visibility="{Binding SettingVisibility}" Margin="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="指定响应内容" Grid.Row="0" Grid.Column="0" Margin="4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="文本格式：" Style="{StaticResource TextBlockBoldBaseStyle}" Margin="4"/>
                                    <hc:ComboBox
                                        ItemsSource="{Binding ContentTypeList}"
                                        SelectedIndex="{Binding ContentTypeSelectedIndex}"
                                        Margin="4" 
                                        MinWidth="100"/>
                                    <CheckBox Content="使用" Style="{StaticResource ToggleButtonDanger}"  IsChecked="{Binding IsUseTextBox}"/>
                                    
                                    <Button Content="新增文本" Command="{Binding OpenAddControlCmd}" HorizontalAlignment="Right" Style="{StaticResource ButtonSuccess}" Margin="4"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RawUrl：" Style="{StaticResource TextBlockBoldBaseStyle}" Margin="4"/>
                                    <hc:ComboBox
                                        ItemsSource="{Binding RawUrlList}"
                                        SelectedItem="{Binding SelectedRawUrl}"
                                        Margin="4"
                                        MinWidth="140"/>
                                    <TextBlock Text="文本列表：" Style="{StaticResource TextBlockBoldBaseStyle}" Margin="4"/>
                                    <hc:ComboBox
                                        ItemsSource="{Binding ContentList}"
                                        SelectedIndex="{Binding ContentSelectedIndex}"
                                        SelectionChanged="ComboBox_SelectionChanged"
                                        Margin="4" 
                                        MinWidth="140"/>
                                </StackPanel>
                                    <TextBox Text="{Binding ParticularText}" TextWrapping="Wrap" IsEnabled="{Binding IsUseTextBox}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="响应内容" Grid.Row="0" Grid.Column="1" MinWidth="200" Margin="4">
                            <TextBox Text="{Binding ReposeText}" TextWrapping="Wrap" IsReadOnly="True"/>
                        </GroupBox>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </hc:ScrollViewer>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <TextBlock Text="请求记录数量：" VerticalAlignment="Center" Style="{StaticResource TextBlockDefaultPrimary}" Margin="4"/>
            <TextBlock Text="{Binding RequestDatasCount}" VerticalAlignment="Center" Style="{StaticResource TextBlockDefaultPrimary}" Margin="4"/>
            <Button Content="清空记录" Style="{StaticResource ButtonDanger}" Command="{Binding ClearCmd}" Margin="80,4"/>
        </StackPanel>
    </Grid>
</hc:Window>
