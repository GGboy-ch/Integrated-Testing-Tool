<Window x:Class="HTTPServer.Veiw.SettingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:veiwmodel="clr-namespace:HTTPServer.VeiwModel"
        d:DataContext="{d:DesignInstance Type=veiwmodel:MainViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="设置"
        Height="240"
        MinHeight="240"
        SizeToContent="Height"
        Width="560"
        Background="#F4F7FB">
    <Grid Margin="8">
        <Border Background="White"
                BorderBrush="#E4E9F2"
                BorderThickness="1"
                CornerRadius="10"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="应用设置" FontSize="18" FontWeight="SemiBold" Foreground="#172033"/>
                    <TextBlock Text="配置窗口关闭行为"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="#667085"/>
                </StackPanel>

                <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="7" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="关闭时隐藏到托盘" FontWeight="SemiBold" Foreground="#344054"/>
                            <TextBlock Text="关闭主窗口后，服务仍在后台运行"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="#667085"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding IsHideToTray}"
                                  VerticalAlignment="Center"
                                  Margin="8,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
