<windows:GeneralApplication x:Class="LogProfiler.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:windows="clr-namespace:GeneralLibrary.Windows;assembly=GeneralLibrary"
             xmlns:tray="clr-namespace:ToolTray"
             xmlns:local="clr-namespace:LogProfiler"
             StartupUri="Views/MainWindow.xaml">
    <windows:GeneralApplication.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TrayTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ContextMenu x:Shared="false" x:Key="SysTrayMenu" Style="{StaticResource ToolTrayMenuStyle}">
                <MenuItem Style="{StaticResource ToolTrayMenuItemStyle}" Header="显示主界面" Command="{Binding NotifyCommand}" CommandParameter="0">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/LogProfiler;component/Images/MainWindow.ico"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Style="{StaticResource ToolTrayMenuItemStyle}" Header="设置" Command="{Binding NotifyCommand}" CommandParameter="1">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/LogProfiler;component/Images/Setting.ico"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Style="{StaticResource ToolTrayMenuItemStyle}" Header="退出" Command="{Binding NotifyCommand}" CommandParameter="2">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/LogProfiler;component/Images/Exit.ico"/>
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
            <tray:ThemedTaskbarIcon
                x:Key="Taskbar"
                ToolTipText="日志分析工具"
                DoubleClickCommand="{Binding NotifyCommand}"
                DoubleClickCommandParameter="0"
                ContextMenu="{StaticResource SysTrayMenu}"
                AppIconSource="pack://application:,,,/LogProfiler;component/images/logprofiler.ico">
            </tray:ThemedTaskbarIcon>
        </ResourceDictionary>
    </windows:GeneralApplication.Resources>
</windows:GeneralApplication>
