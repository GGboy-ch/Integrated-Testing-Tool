<Application x:Class="LogProfiler.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             xmlns:local="clr-namespace:LogProfiler"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ContextMenu x:Shared="false" x:Key="SysTrayMenu">
                <MenuItem Height="26" Header="显示主界面" Width="100" Command="{Binding NotifyCommand}" CommandParameter="0" Padding="2" HorizontalContentAlignment="Center">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/LogProfiler;component/Images/MainWindow.ico"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Height="26" Header="设置" Width="100" Command="{Binding NotifyCommand}" CommandParameter="1" Padding="2" HorizontalContentAlignment="Center">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/LogProfiler;component/Images/Setting.ico"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Height="26" Header="退出" Width="100" Command="{Binding NotifyCommand}" CommandParameter="2" Padding="2" HorizontalContentAlignment="Center">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/LogProfiler;component/Images/Exit.ico"/>
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
            <tb:TaskbarIcon 
                x:Key="Taskbar" 
                ToolTipText="日志分析工具"            
                DoubleClickCommand="{Binding NotifyCommand}" 
                DoubleClickCommandParameter="0"            
                ContextMenu="{StaticResource SysTrayMenu}" 
                IconSource="pack://application:,,,/LogProfiler;component/images/logprofiler.ico">
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
