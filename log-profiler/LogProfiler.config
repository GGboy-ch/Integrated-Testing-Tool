<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!--启动时是否自动创建桌面快捷方式-->
    <IsAutoCreateDesktopShortcut>true</IsAutoCreateDesktopShortcut>
    <!--仅勾选后在下次启动检查更新；旧配置默认关闭-->
    <IsAutoUpdate>false</IsAutoUpdate>
    <!--关闭软件时是否隐藏到托盘-->
    <IsHideToTray>false</IsHideToTray>
    <!--下载日志文件的网址-->
    <LogDownloadUri>http://127.0.0.1:6060</LogDownloadUri>
</configuration>
