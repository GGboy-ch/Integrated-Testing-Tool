<Window x:Class="LogProfiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:LogProfiler"
        xmlns:windows="clr-namespace:GeneralLibrary.Windows;assembly=GeneralLibrary"
        xmlns:views="clr-namespace:LogProfiler.Views"
        xmlns:prop="clr-namespace:LogProfiler.Res"
        xmlns:viewmodels="clr-namespace:LogProfiler.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Icon="pack://application:,,,/LogProfiler;component/images/logprofiler.ico"
        WindowStartupLocation="CenterScreen"
        windows:WindowTitleVersionBehavior.Version="{x:Static local:ToolVersion.Current}"
        Title="{x:Static prop:Res.ProjectName}" Height="540" Width="900">
    <Window.Resources>
        <local:DateTimeConverter x:Key="DateTimeConverter"/>
        <local:IntDataConverter x:Key="IntDataConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <views:SimulationButtonStyleConverter x:Key="SimulationButtonStyleConverter"/>
        <ContextMenu x:Key="ListBoxConteMenu">
            <MenuItem Header="查看相邻日志" Command="{Binding SearchContiguousCmd}"/>
            <MenuItem Header="复制" Command="{Binding CopyLogCmd}"/>
        </ContextMenu>
        <DataTemplate x:Key="ItemTemplate">
            <StackPanel Orientation="Horizontal" Height="{Binding RealLogDataLength}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTimeout}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.TimeoutBackgroundBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsTimeout}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource Theme.NormalBackgroundBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBaseData}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.BaseDataBackgroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding LogDatetime, Converter={StaticResource DateTimeConverter}}" Foreground="{DynamicResource Theme.WindowForegroundBrush}" VerticalAlignment="Center" Margin="10,0"/>
                <Canvas Margin="10,0">
                    <Line X1="5" Y1="0" X2="5" Y2="{Binding TopofHalfRealLogDataLength}" Stroke="{DynamicResource Theme.WindowForegroundBrush}"/>
                    <Ellipse Height="10" Width="10" StrokeThickness="2" Stroke="{DynamicResource WarningBrush}" Canvas.Top="{Binding TopofHalfRealLogDataLength}"/>
                    <Line X1="5" Y1="{Binding BottomofHalfRealLogDataLength}" X2="5" Y2="{Binding RealLogDataLength}" Stroke="{DynamicResource Theme.WindowForegroundBrush}"/>
                </Canvas>
                <Label Content="{Binding LogContent}"  VerticalAlignment="Center" Margin="10,0"/>
            </StackPanel>
        </DataTemplate>
        <Style TargetType="ListBox" BasedOn="{StaticResource ListBoxBaseStyle}">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemBaseStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,0.4"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="3,1,1,1"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource Theme.SecondaryBackgroundBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Visible"/>
            <Setter Property="ContextMenu" Value="{StaticResource ListBoxConteMenu}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="开始时间:" Foreground="{DynamicResource Theme.WindowForegroundBrush}" VerticalAlignment="Center" Margin="4"/>
            <hc:DateTimePicker SelectedDateTime="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" MinWidth="120" Height="20" Margin="4"/>
            <TextBlock Text="结束时间:" Foreground="{DynamicResource Theme.WindowForegroundBrush}" VerticalAlignment="Center" Margin="4"/>
            <hc:DateTimePicker SelectedDateTime="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" MinWidth="120" Height="20" Margin="4"/>
            <TextBlock Text="设备:" Foreground="{DynamicResource Theme.WindowForegroundBrush}" VerticalAlignment="Center" Margin="4"/>
            <ComboBox ItemsSource="{Binding DeviceNameList}" SelectedItem="{Binding DeviceName}" Width="120" Height="20" Margin="4"/>
            <Button Content="正则" Command="{Binding RegexCmd}" Height="20" Margin="4"/>
            <TextBlock Text="超时阈值(/ms):" Foreground="{DynamicResource Theme.WindowForegroundBrush}" VerticalAlignment="Center" Margin="4"/>
            <TextBox Text="{Binding TimeoutThreshold, Converter={StaticResource IntDataConverter}}" HorizontalContentAlignment="Center" Width="50" Height="20" Margin="4"/>
            <Button Height="24" Command="{Binding NotifyCommand}" CommandParameter="1" HorizontalAlignment="Right" Margin="8,0" Padding="0">
                <Image Source="pack://application:,,,/LogProfiler;component/Images/Setting.ico"/>
            </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <Button Content="下载最新日志" Command="{Binding OpenDownloadLogWindowCmd}" Margin="16,4,8,4"/>
            <Button Content="导入日志" Command="{Binding GetLogCmd}" Margin="8,4,8,4"/>
            <Button Content="清空日志缓存" Command="{Binding ClearLogCmd}" Margin="8,4,8,4"/>
            <Button Content="查询" Command="{Binding SelectCmd}" Margin="4"/>
            <Button Content="模拟" Command="{Binding Simulation.ConfigureCommand}" Margin="4"/>
            <Button Content="{Binding Simulation.StartStopText}" Command="{Binding Simulation.StartStopCommand}"
                    Style="{Binding Simulation.IsRunning, Converter={StaticResource SimulationButtonStyleConverter}}"
                    Visibility="{Binding Simulation.IsConfigured, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="4"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="占比宽度调整" Foreground="{DynamicResource Theme.WindowForegroundBrush}" HorizontalAlignment="Center"/>
        <Slider x:Name="slider" Grid.Row="3" Maximum="1" TickFrequency="0.1" SmallChange="0.01" TickPlacement="TopLeft" IsMoveToPointEnabled="True" Value="{Binding SliderValue}"/>
        <TabControl Grid.Row="4" Margin="8" Background="Transparent" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0">
            <TabItem Header="Debug日志" Foreground="{DynamicResource Theme.WindowForegroundBrush}" Background="Transparent">
                <ListBox ItemsSource="{Binding DebugLogDatas}" SelectedIndex="{Binding SelectedLogIndex}" SelectionChanged="LogList_SelectionChanged" ItemTemplate="{StaticResource ItemTemplate}"/>
            </TabItem>
            <TabItem Header="Info日志" Foreground="{DynamicResource Theme.WindowForegroundBrush}" Background="Transparent">
                <ListBox ItemsSource="{Binding InfoLogDatas}" SelectedIndex="{Binding SelectedLogIndex}" SelectionChanged="LogList_SelectionChanged" ItemTemplate="{StaticResource ItemTemplate}"/>
            </TabItem>
            <TabItem Header="Exception日志" Foreground="{DynamicResource Theme.WindowForegroundBrush}" Background="Transparent">
                <ListBox ItemsSource="{Binding ExceptionLogDatas}" SelectedIndex="{Binding SelectedLogIndex}" SelectionChanged="LogList_SelectionChanged" ItemTemplate="{StaticResource ItemTemplate}"/>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="上一页" Command="{Binding PreviewPageCmd}" Margin="16,4,4,4"/>
            <TextBox x:Name="page" Text="{Binding Page}" HorizontalContentAlignment="Center" MinWidth="40" MaxHeight="30" Margin="4"/>
            <Button Content="下一页" Command="{Binding NextPageCmd}" Margin="4"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="6">
            <Label Content="当前展示数量:" Foreground="{DynamicResource Theme.WindowForegroundBrush}" Background="Transparent" VerticalAlignment="Center" Margin="16,0"/>
            <Label Content="{Binding CurrentLogDataCount}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
            <Label Content="(单页面最多显示:)" Foreground="{DynamicResource Theme.WindowForegroundBrush}" Background="Transparent" VerticalAlignment="Center" Margin="16,0"/>
            <Label Content="{Binding PageSize}" HorizontalContentAlignment="Center" Width="50" Margin="4"/>
            <Label Content="筛选结果：" Foreground="{DynamicResource Theme.WindowForegroundBrush}" Background="Transparent" VerticalAlignment="Center" Margin="16,0"/>
            <Label Content="{Binding LogDataCount}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
            <Label Content="超时数量：" Foreground="{DynamicResource Theme.WindowForegroundBrush}" Background="Transparent" VerticalAlignment="Center" Margin="16,0"/>
            <Label Content="{Binding TimeoutCount}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
