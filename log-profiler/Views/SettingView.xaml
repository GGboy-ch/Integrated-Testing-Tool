<Window x:Class="LogProfiler.Views.SettingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogProfiler.Views"
        xmlns:viewmodels="clr-namespace:LogProfiler.ViewModels" 
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Icon="pack://application:,,,/LogProfiler;component/Images/Logprofiler.ico"
        WindowStartupLocation="CenterOwner"
        Title="设置" Height="200" Width="400" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="8">
            <CheckBox Content="是否开机自启" Foreground="{DynamicResource Theme.WindowForegroundBrush}" IsChecked="{Binding IsAutoStart}" Margin="8"/>
            <CheckBox Grid.Row="1" Content="关闭时隐藏到托盘" Foreground="{DynamicResource Theme.WindowForegroundBrush}" IsChecked="{Binding IsHideToTray}" Margin="8"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <TextBlock Text="下载日志的域名：" Foreground="{DynamicResource Theme.WindowForegroundBrush}" VerticalAlignment="Center" Margin="8"/>
            <TextBox x:Name="textBox" Text="{Binding LogDownloadUri}" MinWidth="240" MaxHeight="30" Margin="8"/>
        </StackPanel>
    </Grid>
</Window>
