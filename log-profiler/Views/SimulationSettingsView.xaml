<Window x:Class="LogProfiler.Views.SimulationSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模拟发送配置" Width="390" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="85"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="75"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="协议" VerticalAlignment="Center" Margin="4"/>
        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="4"
                  SelectedIndex="{Binding ProtocolIndex, Mode=TwoWay}">
            <ComboBoxItem Content="UDP"/>
            <ComboBoxItem Content="TCP"/>
        </ComboBox>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="本地 IP" VerticalAlignment="Center" Margin="4"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LocalIp, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="端口" VerticalAlignment="Center" Margin="4"/>
        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="目标 IP" VerticalAlignment="Center" Margin="4"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RemoteIp, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="端口" VerticalAlignment="Center" Margin="4"/>
        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
        <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Text="{Binding ErrorMessage}" Foreground="DarkRed"
                   TextWrapping="Wrap" Margin="4,8,4,0"/>
        <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,12,4,0">
            <Button Content="保存" Width="70" IsDefault="True" Command="{Binding SaveCommand}" Margin="4"/>
            <Button Content="取消" Width="70" IsCancel="True" Margin="4"/>
        </StackPanel>
    </Grid>
</Window>
