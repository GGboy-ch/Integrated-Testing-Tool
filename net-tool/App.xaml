<windows:GeneralApplication x:Class="NetTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:windows="clr-namespace:GeneralLibrary.Windows;assembly=GeneralLibrary"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:NetTool"
             StartupUri="View/MainWindow.xaml">
    <windows:GeneralApplication.Resources>
        <ResourceDictionary>
            <ContextMenu x:Shared="false" x:Key="SysTrayMenu">
                <MenuItem Height="25" Header="显示主界面" Width="100" Command="{Binding NotifyCommand}" CommandParameter="1" Padding="2" HorizontalContentAlignment="Center">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/NetTool;component/Images/home.ico"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Height="25" Header="隐藏界面" Width="100" Command="{Binding NotifyCommand}" CommandParameter="0" Padding="2" HorizontalContentAlignment="Center">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/NetTool;component/Images/hide.ico"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Height="25" Header="退出" Width="100" Command="{Binding NotifyCommand}" CommandParameter="2" Padding="2" HorizontalContentAlignment="Center">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/NetTool;component/Images/close.ico"/>
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
            <tb:TaskbarIcon x:Key="Taskbar" ToolTipText="IPv6公网获取工具"
            DoubleClickCommand="{Binding NotifyCommand}"  DoubleClickCommandParameter="1"
            ContextMenu="{StaticResource SysTrayMenu}" IconSource="Images/ipv6.ico">
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </windows:GeneralApplication.Resources>
</windows:GeneralApplication>
