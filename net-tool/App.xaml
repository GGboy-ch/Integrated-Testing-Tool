<windows:GeneralApplication x:Class="NetTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:windows="clr-namespace:GeneralLibrary.Windows;assembly=GeneralLibrary"
             xmlns:tray="clr-namespace:ToolTray"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:NetTool"
             StartupUri="View/MainWindow.xaml">
    <windows:GeneralApplication.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TrayTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ContextMenu x:Shared="false" x:Key="SysTrayMenu" Style="{StaticResource ToolTrayMenuStyle}">
                <MenuItem Style="{StaticResource ToolTrayMenuItemStyle}" Header="显示主界面" Command="{Binding NotifyCommand}" CommandParameter="1">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/NetTool;component/Images/home.ico"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Style="{StaticResource ToolTrayMenuItemStyle}" Header="隐藏界面" Command="{Binding NotifyCommand}" CommandParameter="0">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/NetTool;component/Images/hide.ico"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Style="{StaticResource ToolTrayMenuItemStyle}" Header="退出" Command="{Binding NotifyCommand}" CommandParameter="2">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/NetTool;component/Images/close.ico"/>
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
            <tray:ThemedTaskbarIcon x:Key="Taskbar" ToolTipText="IPv6公网获取工具"
            DoubleClickCommand="{Binding NotifyCommand}"  DoubleClickCommandParameter="1"
            ContextMenu="{StaticResource SysTrayMenu}" AppIconSource="Images/ipv6.ico">
            </tray:ThemedTaskbarIcon>
        </ResourceDictionary>
    </windows:GeneralApplication.Resources>
</windows:GeneralApplication>
