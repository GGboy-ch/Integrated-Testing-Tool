<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!--启动时是否自动创建桌面快捷方式-->
    <IsAutoCreateDesktopShortcut>false</IsAutoCreateDesktopShortcut>
	<!--是否开机自启-->
	<IsOpenStartup>true</IsOpenStartup>
	<!--关闭软件后是否隐藏到托盘-->
	<IsHideToTray>true</IsHideToTray>
	<!--是否自动关闭软件-->
	<IsAutoClosedApp>false</IsAutoClosedApp>
	<!--软件启动后延迟多久关闭软件，单位(s)-->
	<DelayTime>10</DelayTime>
</configuration>