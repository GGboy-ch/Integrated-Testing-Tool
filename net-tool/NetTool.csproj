<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 版本由 AssemblyInfo.cs 统一定义，避免 SDK 重复生成属性。 -->
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <Nullable>enable</Nullable>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <ProjectGuid>{A2C27A4D-E548-41D5-B8CA-E22B37525CB1}</ProjectGuid>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>NetTool.ico</ApplicationIcon>
  </PropertyGroup>


  <ItemGroup>
    <None Remove="Images\close.ico" />
    <None Remove="Images\hide.ico" />
    <None Remove="Images\home.ico" />
    <None Remove="ipv6.png" />
    <None Remove="NetTool.config" />
    <None Remove="Setting.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="NetTool.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="NetTool.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\Setting.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\hide.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\close.ico" />
    <Resource Include="Images\home.ico" />
    <Resource Include="NetTool.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\ipv6.ico" />
    <Resource Include="Images\ipv6.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Costura.Fody" Version="6.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="log4net" Version="3.4.0" />
    <PackageReference Include="MySql.Data" Version="26.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\general-library\GeneralLibrary\GeneralLibrary.csproj" />
  </ItemGroup>
<Target Name="PackProject" AfterTargets="AfterBuild" Condition=" '$(Configuration)' == 'Release' ">
    <Exec Command="&quot;..\SetupTool\bin\Debug\net8.0\SetupTool.exe&quot; $(ProjectDir)" />
</Target>
  <ItemGroup>
    <Compile Include="..\Shared\ManualUpdateController.cs" Link="Updates\ManualUpdateController.cs" />
  </ItemGroup>
</Project>
