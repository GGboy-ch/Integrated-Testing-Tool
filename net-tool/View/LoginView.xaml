<hc:PopupWindow x:Class="NetTool.View.LoginView"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetTool.View" 
        xmlns:viewmoduel="clr-namespace:NetTool.ViewModuel" 
        d:DataContext="{d:DesignInstance Type=viewmoduel:MainViewModuel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="登录界面" Height="200" Width="350">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFB3E5FC" Offset="0"/>
                <GradientStop Color="#1890FF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Content="用户名：" Background="Transparent" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Username}" Margin="8" MinWidth="200"/>
        <Label Grid.Row="1" Content="密码：" Background="Transparent" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8"/>
        <PasswordBox Grid.Row="1" Grid.Column="1" viewmoduel:PasswordBoxHelper.Password="{Binding Password, Mode=TwoWay}" Margin="8" MinWidth="200"/>
        <Button Grid.Row="2" Grid.ColumnSpan="2" FontSize="14" Command="{Binding LoginCmd}" IsDefault="True" Style="{StaticResource ButtonSuccess}" Content="登录" Margin="8" HorizontalAlignment="Center" Width="80"/>
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding LoginTip}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoginFailed}" Value="True">
                            <Setter Property="Foreground" Value="Red"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</hc:PopupWindow>
