<hc:Window x:Class="NetTool.MainWindow"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetTool"
        xmlns:viewmodel="clr-namespace:NetTool.ViewModuel"
        d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModuel}"
        mc:Ignorable="d"
        Icon="/Images/ipv6.png"
        WindowStartupLocation="CenterScreen"
        Title="公网ip助手" Height="160" Width="550">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="White" Offset="0"/>
                <GradientStop Color="#57C0F8" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2">
            <CheckBox x:Name="isAutoStart" Content="开机自启" Foreground="White" IsChecked="{Binding IsOpenStartup}" Margin="10,0"/>
            <CheckBox Content="极简模式" Foreground="White" IsChecked="{Binding IsAutoClosedApp}" Margin="10,0"/>
            <CheckBox Content="最小化至托盘" Foreground="White" IsChecked="{Binding IsHideToTray}" Margin="10,0"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <TextBlock Text="归属地：" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox Text="{Binding DeviceName}" Margin="0,4" Width="150"/>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Label Content="本机IPv6地址：" Foreground="White" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4"/>
            <TextBox Grid.Column="1" Text="{Binding IPv6Address}" MinHeight="30" MinWidth="360" Margin="2,4"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource ButtonPrimary}" Command="{Binding GetIPListCmd}" Content="获取全部IPv6地址" Margin="4"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding IPv6Collection}" MinHeight="30" MinWidth="360" Margin="2,4"/>
        </Grid>
    </Grid>
</hc:Window>
