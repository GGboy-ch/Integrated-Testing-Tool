<Window x:Class="NetTool.View.SettingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="340"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <CheckBox Content="开机自启"
                  Foreground="{DynamicResource Theme.WindowForegroundBrush}"
                  IsChecked="{Binding IsOpenStartup}"/>
        <CheckBox Content="极简模式"
                  Foreground="{DynamicResource Theme.WindowForegroundBrush}"
                  IsChecked="{Binding IsAutoClosedApp}"
                  ToolTip="下次启动时生效"
                  Margin="0,10,0,0"/>
        <CheckBox Content="最小化至托盘"
                  Foreground="{DynamicResource Theme.WindowForegroundBrush}"
                  IsChecked="{Binding IsHideToTray}"
                  Margin="0,10,0,0"/>
        <CheckBox Content="启动时创建桌面快捷方式"
                  Foreground="{DynamicResource Theme.WindowForegroundBrush}"
                  IsChecked="{Binding ShortcutPreference.IsEnabled}"
                  ToolTip="下次启动时生效"
                  Margin="0,10,0,0"/>
        <Button Content="关闭" IsCancel="True" HorizontalAlignment="Right" Margin="0,20,0,0" Padding="12,4"/>
    </StackPanel>
</Window>
